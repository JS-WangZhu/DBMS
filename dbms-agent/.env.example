# API Key for authentication (must match main project)
AGENT_API_KEY=your-agent-api-key-here

# Flask configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Agent settings
AGENT_HOST=0.0.0.0
AGENT_PORT=5001
AGENT_DEBUG=false

# Optional backup restart recovery. Leave disabled to retain the legacy
# in-memory task behavior. AGENT_TASK_STATE_DIR must be on persistent storage.
AGENT_RECOVERY_ENABLED=false
DBMS_SERVER_URL=http://dbms-server:5000
DBMS_AGENT_ID=
AGENT_TASK_STATE_DIR=/data/backups/.agent-tasks

# Logging
LOG_LEVEL=INFO

# Backup tool paths (optional, defaults to system PATH)
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# MONGODUMP_PATH=/usr/bin/mongodump
