FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
AUTH_IDLE_TIMEOUT_SECONDS=28800
FERNET_KEY=
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/dbms_meta
AUTH_MODE=local
LDAP_SERVER_URI=
LDAP_BASE_DN=
LDAP_USER_DN_TEMPLATE=
SSO_ENABLED=false
SSO_PROVIDER_NAME=SSO
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_SCOPE=openid profile email
SSO_REDIRECT_URI=
SSO_USERNAME_FIELD=preferred_username
SSO_EMAIL_FIELD=email
AUTO_BOOTSTRAP_ADMIN=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
ENABLE_SCHEDULER=true
WECHAT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
SMTP_TO=
BACKUP_NOTIFY_CHANNELS=wecom,email
MONITOR_COLLECT_WORKERS=8
# Backup tools paths
# Set full paths to backup tools if they are not in system PATH
MYSQLDUMP_PATH=mysqldump
MONGODUMP_PATH=mongodump
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true 
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CLICKHOUSE_AUDIT_HOST=127.0.0.1
CLICKHOUSE_AUDIT_PORT=8123
CLICKHOUSE_AUDIT_USER=default
CLICKHOUSE_AUDIT_PASSWORD=
CLICKHOUSE_AUDIT_DATABASE=dbms_audit
CLICKHOUSE_AUDIT_TABLE=query_audit_events
CLICKHOUSE_AUDIT_SECURE=false
CLICKHOUSE_AUDIT_VERIFY=true
CLICKHOUSE_AUDIT_CONNECT_TIMEOUT=5
CLICKHOUSE_AUDIT_QUERY_TIMEOUT=15
# 兼容以下通用命名；未设置 CLICKHOUSE_AUDIT_* 时生效
# CLICKHOUSE_DB=default
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
